{
  "name": "leaki",
  "version": "1.1.0",
  "private": true,
  "description": "Leaki — Catálogo de repetição espaçada (Capacitor Android)",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare:web": "node scripts/prepare-web.mjs",
    "web": "npm run build && npm run prepare:web && node scripts/serve.mjs",
    "dev": "npm run web",
    "host": "npm run web",
    "tunnel": "cloudflared tunnel --config cloudflared.yml run",
    "assets": "npx @capacitor/assets generate --android --iconBackgroundColor '#111114' --iconBackgroundColorDark '#111114' --splashBackgroundColor '#111114' --splashBackgroundColorDark '#111114'",
    "sync": "npm run build && npm run prepare:web && npx cap sync android",
    "open:android": "npx cap open android",
    "android": "npm run sync && npx cap open android",
    "test:tts": "node scripts/test-edge-tts.mjs",
    "test:ui": "node scripts/test-ui-cards.mjs",
    "test:study": "node scripts/test-study-rate.mjs",
    "test:parent": "node scripts/test-parent-digest.mjs",
    "test:suggest": "node scripts/test-content-suggest.mjs",
    "test:sync": "node scripts/test-sync.mjs",
    "build:apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "build:release": "npm run sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "esbuild": "^0.28.2"
  }
}
